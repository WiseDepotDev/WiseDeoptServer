# 本地敏感配置覆盖文件模板（**本文件入库，不含任何真实凭据**）
#
# 用法：
#   1. 复制为同目录下的 application-local.yml（该文件已被 .gitignore 排除）；
#   2. 填入本环境的真实地址与凭据；
#   3. 从 WiseDeoptServer/ 目录启动服务，application.yml 中
#      spring.profiles.include: local 会自动加载它。
#
# 也可以完全不使用本文件，改为通过环境变量注入：
#   WISE_DB_URL WISE_DB_USERNAME WISE_DB_PASSWORD
#   WISE_REDIS_HOST WISE_REDIS_PORT WISE_REDIS_PASSWORD
#   WISE_MINIO_ENDPOINT WISE_MINIO_ACCESS_KEY WISE_MINIO_SECRET_KEY WISE_MINIO_BUCKET
#   WISE_ADMIN_USERNAME WISE_ADMIN_PASSWORD WISE_ADMIN_RESET_PASSWORD
#   WISE_OPERATOR_USERNAME WISE_OPERATOR_PASSWORD
#   WISE_JWT_SECRET WISE_API_SIGNATURE_SECRET
#   WISE_MQTT_URL WISE_MQTT_USERNAME WISE_MQTT_PASSWORD
#   WISE_CORS_ALLOWED_ORIGINS
#
# 约束（STD-SEC-01）：凭据类配置在 application.yml 中一律无默认值，
#   未注入时服务快速失败并给出缺失的变量名，而不是退化到弱口令启动。

spring:
    datasource:
        url: jdbc:mysql://DB_HOST:3306/wise_depot?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8
        username: DB_USER
        password: DB_PASSWORD
    data:
        redis:
            # 实际生效的是下方 wise.redis.*（RedisConfig 的唯一来源）
            host: REDIS_HOST
            port: 6379
            password: REDIS_PASSWORD
    minio:
        endpoint: http://MINIO_HOST:9000
        access-key: MINIO_ACCESS_KEY
        secret-key: MINIO_SECRET_KEY
    auth:
        admin:
            password: ADMIN_PASSWORD
        operator:
            password: OPERATOR_PASSWORD

jwt:
    # HS512 签名密钥，长度必须 ≥ 64 字节，建议用 `openssl rand -base64 96` 生成
    secret: JWT_SECRET_AT_LEAST_64_BYTES

api:
    # 请求签名 HMAC-SHA256 密钥，长度必须 ≥ 32 字节
    signature:
        secret: API_SIGNATURE_SECRET_AT_LEAST_32_BYTES

# Redis 配置的唯一来源（RedisConfig 通过 wise.redis.* 构建连接工厂；
# spring.data.redis.* 由 application.yml 派生自本块，无需在此重复）
wise:
    redis:
        host: REDIS_HOST
        port: 6379
        password: REDIS_PASSWORD

mqtt:
    broker:
        url: tcp://MQTT_HOST:1883
        username: MQTT_USERNAME
        password: MQTT_PASSWORD
